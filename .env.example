# Kopieren nach .env und ausfüllen. Wird von `npm run build` und `docker compose` gelesen.

# Öffentliche Adresse der Seite (ohne / am Ende) – für Canonical-Link, Vorschaubild und Sitemap
SITE_URL=https://monthgrid.verzonex.com

# Rybbit-Statistik (optional) – Script-Adresse und Site-ID aus dem Rybbit-Dashboard
#   Rybbit Cloud:     https://app.rybbit.io/api/script.js
#   Selbst gehostet:  https://rybbit.deine-domain.de/api/script.js
RYBBIT_SCRIPT_URL=https://app.rybbit.io/api/script.js
RYBBIT_SITE_ID=

# Optional: Jahr in Titel/Beschreibung festlegen (Standard: ab Juli automatisch das Folgejahr)
# SEO_YEAR=2027
