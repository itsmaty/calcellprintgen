{
  "name": "calcellprintgen",
  "private": true,
  "version": "1.0.0",
  "description": "Kalenderzellen-Generator für Druckkalender – erzeugt 12 Monatsraster als PNG/SVG, komplett lokal im Browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:standalone": "tsc --noEmit && vite build --mode standalone && node -e \"require('fs').renameSync('dist-standalone/index.html','dist-standalone/CalCell-PrintGen.html')\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fonts": "node scripts/fetch-fonts.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "opentype.js": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
