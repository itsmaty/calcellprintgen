# Caddy kümmert sich automatisch um HTTPS-Zertifikate (Let's Encrypt).
# Domain anpassen, Datei z. B. nach /etc/caddy/Caddyfile kopieren, dann: sudo systemctl reload caddy

# --- Variante A: Docker-Container (docker compose up -d --build) hinter Caddy ---
monthgrid.verzonex.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080
	header Strict-Transport-Security "max-age=31536000"
}

