# Produktions-Einstellungen für `npm run build` und den Docker-Build (z. B. in Dokploy).
# Nicht geheim – die Werte landen ohnehin sichtbar im HTML. Gesetzte Build-Argumente bzw.
# Umgebungsvariablen haben Vorrang (leere Werte werden ignoriert).

# Öffentliche Adresse (ohne / am Ende) – für Canonical, hreflang, Vorschaubild und Sitemap
SITE_URL=https://monthgrid.verzonex.com

# Rybbit-Statistik: Site-ID aus dem Rybbit-Dashboard eintragen (oder in Dokploy als Build-Argument setzen)
RYBBIT_SCRIPT_URL=https://app.rybbit.io/api/script.js
RYBBIT_SITE_ID=
